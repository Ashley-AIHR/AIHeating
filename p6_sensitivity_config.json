{
  "version": "p6-linearisation-v1",
  "frozenBeforeCanonicalEvaluation": true,
  "method": "finite-difference around Traditional v1.2 issued-forecast continuation",
  "perturbations": {
    "supplyC": 0.5,
    "pumpHz": 0.5,
    "valveFraction": 0.02
  },
  "differenceRule": "central where both legal, otherwise one-sided",
  "outputs": [
    "buildingTemperatureC",
    "actualHeatSupplyMW",
    "zoneFlowM3H",
    "pumpPowerKW"
  ],
  "validationTrialOffsets": [
    [-1.0, -1.0, -0.05, 0.00, 0.05],
    [1.0, 1.0, 0.05, 0.00, -0.05],
    [-1.5, 0.5, 0.00, 0.05, -0.05],
    [0.5, -1.5, -0.05, 0.05, 0.00]
  ]
}
