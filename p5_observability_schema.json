{
  "version": "p5-observability-schema-v1",
  "selectedModelAllowedClasses": ["A", "B", "C", "D", "E"],
  "classes": {
    "A": "real-time telemetry",
    "B": "configured static building information",
    "C": "historical telemetry",
    "D": "issued external forecast",
    "E": "derived from accepted P1A hydraulic/transport model",
    "F": "hidden simulation truth; forbidden to selected calibration and prediction"
  },
  "fields": [
    {"name": "forecast_as_of", "class": "A", "role": "lineage"},
    {"name": "timestamp", "class": "A", "role": "current/trajectory time"},
    {"name": "building_id", "class": "B", "role": "identity"},
    {"name": "zone", "class": "B", "role": "network topology"},
    {"name": "area_m2", "class": "B", "role": "static metadata"},
    {"name": "insulation_class", "class": "B", "role": "static metadata"},
    {"name": "orientation_factor", "class": "B", "role": "configured prior"},
    {"name": "nominal_solar_aperture_m2", "class": "B", "role": "configured prior"},
    {"name": "nominal_internal_gain_w", "class": "B", "role": "configured prior"},
    {"name": "nominal_h_w_k", "class": "B", "role": "bounded class prior"},
    {"name": "nominal_c_j_k", "class": "B", "role": "bounded class prior"},
    {"name": "nominal_radiator_ua_w_k", "class": "B", "role": "bounded emitter prior"},
    {"name": "design_flow_share", "class": "B", "role": "configured within-zone allocation"},
    {"name": "indoor_temperature_c", "class": "A", "role": "current model state"},
    {"name": "historical_indoor_temperature_c", "class": "C", "role": "calibration target history"},
    {"name": "outdoor_temperature_c", "class": "A", "role": "current exogenous input"},
    {"name": "solar_radiation_w_m2", "class": "A", "role": "current exogenous input"},
    {"name": "wind_m_s", "class": "A", "role": "context; coefficient-neutral in accepted P1A"},
    {"name": "station_supply_setpoint_c", "class": "A", "role": "planned/control telemetry; not direct building input"},
    {"name": "pump_frequency_hz", "class": "A", "role": "planned/control telemetry; hydraulics input"},
    {"name": "zone_valve_fraction", "class": "A", "role": "planned/control telemetry; hydraulics input"},
    {"name": "zone_flow_m3_s", "class": "A", "role": "measured or P1A-resolved zone flow"},
    {"name": "delivered_zone_supply_c", "class": "E", "role": "P1A FIFO-aligned building water input"},
    {"name": "transport_delay_s", "class": "E", "role": "P1A flow-dependent delay diagnostic"},
    {"name": "derived_building_flow_kg_s", "class": "E", "role": "zone flow times configured design-flow share"},
    {"name": "issued_forecast_outdoor_c", "class": "D", "role": "forecast-driven rollout"},
    {"name": "issued_forecast_solar_w_m2", "class": "D", "role": "forecast-driven rollout"},
    {"name": "issued_forecast_wind_m_s", "class": "D", "role": "forecast context"},
    {"name": "true_thermal_resistance_k_w", "class": "F", "role": "recovery evaluation only"},
    {"name": "true_thermal_capacitance_j_k", "class": "F", "role": "recovery evaluation only"},
    {"name": "true_radiator_ua_w_k", "class": "F", "role": "recovery evaluation only"},
    {"name": "true_solar_scale", "class": "F", "role": "recovery evaluation only"},
    {"name": "true_parameter_multipliers", "class": "F", "role": "recovery evaluation only"},
    {"name": "simulated_building_water_flow_kg_s", "class": "F", "role": "diagnostic upper bound only"},
    {"name": "simulated_radiator_heat_w", "class": "F", "role": "diagnostic only"},
    {"name": "future_actual_weather", "class": "F", "role": "Oracle Exogenous diagnostic only; forbidden in forecast-driven prediction"},
    {"name": "future_indoor_temperature_c", "class": "F", "role": "evaluation label only"}
  ],
  "buildingFlowAdapter": "derived_building_flow_kg_s = rho_water * zone_flow_m3_s * design_flow_share / sum(zone design_flow_share)",
  "calibrationInputView": "site_observable only",
  "truthView": "physically separate simulation_truth shards loaded only after fitting"
}
