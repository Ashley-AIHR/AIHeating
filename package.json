{
  "name": "ai-heating-optimisation-digital-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "test:operations": "node --test server/*.test.mjs",
    "test:workspace": "node scripts/workspace-browser.mjs",
    "test:immersive": "node scripts/immersive-browser.mjs",
    "test:mission": "node scripts/mission-browser.mjs",
    "test:shanghai": "node scripts/shanghai-browser.mjs",
    "test:vision": "node scripts/vision-visual.mjs",
    "test:engineering": "tsx scripts/engineering-invariants.ts",
    "test:engineering:browser": "node scripts/engineering-browser.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "node server/index.mjs",
    "test": "tsx scripts/p0-invariants.ts",
    "test:p4-alignment": "node scripts/p4-ui-alignment-invariants.mjs",
    "test:p7": "tsx scripts/p7-invariants.ts && node scripts/p7-ui-invariants.mjs && tsx scripts/p7-gates.ts",
    "test:p7:browser": "node scripts/p7-browser-with-server.mjs",
    "test:p8": "tsx scripts/p8-invariants.ts && tsx scripts/p8-evaluate.ts && tsx scripts/p8-gates.ts",
